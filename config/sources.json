      "name_link": "h2 a",
      "description": "p",
      "language": "[itemprop=programmingLanguage]",
      "stars_total": "a[href$='/stargazers']",
      "stars_today": "span.d-inline-block.float-sm-right"
    },
    "fallback_search": {
      "_note": "Trendingの読み取りに失敗したら、直近に作成されたリポジトリをスター数順に取る（GitHub Search API、GITHUB_TOKEN）",
      "created_within_days": 7
    }
  },
  "qiita": {
    "label": "Qiita",
    "top": 10,
    "reserve": 10,
    "kind": "feed",
